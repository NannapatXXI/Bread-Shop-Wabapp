# --- Java / Spring Boot (สำคัญมาก) ---
target/
!.mvn/wrapper/maven-wrapper.jar
build/
*.class
*.jar
*.war
*.ear

# --- Database / Temp files ---
*.db
*.sqlite

# --- Docker ---
.docker/
# ถ้าไม่ต้องการเอาไฟล์ env ของ docker ขึ้น
.env.docker

# --- Secrets (ห้ามขึ้น git เด็ดขาด) ---
.env
.env.*
!.env.example

# --- macOS ---
.DS_Store

# --- IDE Config (เพิ่มเติม) ---
.idea/
*.iml
.vscode/
# ยกเว้น settings.json ถ้าอยากแชร์กับทีม แต่แนะนำให้ข้ามไปก่อน
# --- Logs ---
# /logs/ = เฉพาะที่ root — ถ้าไม่มี / นำหน้าจะไปโดน frontend/app/admin/logs/ (หน้าเว็บ) ด้วย
/logs/
backend/logs/
*.log

# --- Uploads ---
uploads/

# --- เครื่องมือ (ผลลัพธ์ที่สร้างใหม่ได้ ไม่ต้องขึ้น git) ---
