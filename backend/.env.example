# คัดลอกไฟล์นี้เป็น backend/.env แล้วใส่ค่าจริง — ห้าม commit .env
# docker-compose.yml อ่านไฟล์ .env นี้ผ่าน env_file

# รหัส root ของ MySQL (ใช้ทั้ง backend และ container db)
DB_PASSWORD=

# Base64 ยาว >= 32 bytes — สร้างใหม่ได้ด้วย: openssl rand -base64 48
JWT_SECRET=

# Google OAuth (Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail สำหรับส่ง OTP (ใช้ App Password ไม่ใช่รหัส Gmail จริง)
MAIL_USERNAME=
MAIL_PASSWORD=
