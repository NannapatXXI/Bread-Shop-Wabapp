  "cards": [
    {
      "dot": "emerald",
      "title": "ที่ทำไว้ดีแล้ว",
      "items": [
        "Token อยู่ใน cookie HttpOnly + SameSite=Lax — JavaScript อ่านไม่ได้",
        "Refresh token เก็บเป็น SHA-256 และ rotate ทุกครั้งที่ใช้",
        "Token ปลอม/ไม่มี → 401, login แล้วแต่ไม่มีสิทธิ์ → 403",
        "ข้อมูลออเดอร์/ที่อยู่/แจ้งเตือน เช็คเจ้าของจาก token เสมอ"
      ]
    },
    {
      "dot": "rose",
      "title": "ต้องแก้",
      "items": [
        "Refresh พร้อมกันหลาย request → ผู้ใช้หลุดไป /login (มีเทสยืนยันแล้ว)",
        "Rate limit เชื่อ X-Forwarded-For → เดารหัสผ่านได้ไม่จำกัด",
        "Google login ไม่มี state → login CSRF",
        "Reset password ไม่ revoke refresh token เดิม"
      ]
    },
    {
      "dot": "slate",
      "title": "นอกภาพนี้",
      "items": [
        "ลืมรหัสผ่าน: send-OTP → verify-otp → reset-password (OTP 5 นาที, ผิดได้ 5 ครั้ง)",
        "Google OAuth: /auth/google → callback → set cookie → redirect /home"
      ]
    }
  ]
