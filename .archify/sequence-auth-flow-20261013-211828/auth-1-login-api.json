  "cards": [
    {
      "dot": "emerald",
      "title": "ที่ทำไว้ดีแล้ว",
      "items": [
        "Token อยู่ใน cookie HttpOnly + SameSite=Lax — JavaScript อ่านไม่ได้",
        "Refresh token เก็บเป็น SHA-256 และ rotate ทุกครั้งที่ใช้",
        "Token ปลอม/ไม่มี → 401, login แล้วแต่ไม่มีสิทธิ์ → 403",
        "ข้อมูลออเดอร์/ที่อยู่/แจ้งเตือน เช็คเจ้าของจาก token เสมอ"
      ]
    },
    {
      "dot": "rose",
      "title": "ต้องแก้ในส่วนนี้",
      "items": [
        "Rate limit เชื่อ X-Forwarded-For → เดารหัสผ่านได้ไม่จำกัด",
        "ผู้ใช้ที่ถูกแบนยังใช้ access token เดิมได้สูงสุด 15 นาที"
      ]
    }
  ]
